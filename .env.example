# ===== Server environment =====
# Node
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# GET /api/health is always on (no configuration needed). It returns only
# status/uptime/job counts — no credentials — and is exempt from rate limiting.

# MongoDB Atlas connection string (use atlas cluster in production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bms

# Optional in-memory (no Redis) fallback is automatic when REDIS_URL is empty.
REDIS_URL=

# Secrets - GENERATE your own values in .env
# The server REFUSES to boot in production without JWT_SECRET / MONGODB_URI.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS - comma separated origins allowed to call the API.
# Must match calling origins EXACTLY (scheme + host, no trailing slash).
# Production (Render) must list the deployed frontend, e.g.:
#   CLIENT_ORIGIN=https://salon-pro-manager.vercel.app
# A mismatch makes browsers reject cross-origin API responses (CORS errors).
CLIENT_ORIGIN=http://localhost:5173

# Set to false to lock the public registration endpoint in production
ALLOW_REGISTRATION=true

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# Business settings
MANAGER_SHARE_PERCENT=60
BARBER_SHARE_PERCENT=40
CURRENCY=RWF
ACCOUNT_PERIOD_DAYS=30
NOTIFICATION_EXPIRY_DAYS=7
RETENTION_MONTHS=6

# Database usage widget quota in MB (default 512 = MongoDB Atlas free tier).
# Override to match your Atlas plan (e.g. 1024, 10240); set to 0 to fall back
# to the database's own filesystem stats when available.
DB_STORAGE_LIMIT_MB=512

# Caching TTLs (seconds)
CACHE_TTL_USER=120
CACHE_TTL_SALON=120
CACHE_TTL_DASHBOARD=60
CACHE_TTL_LIST=60

# Retention service
# DEPRECATED (was never read by the code): RETENTION_CRON=EVERY_DAY_MIDNIGHT
# Use the two variables below instead —
# MAINTENANCE_CRON is a standard 5-field cron expression (minute hour dom month dow).
# Default "0 0 * * *" = every day at 00:00 server time.
# Validate before deploying: an invalid expression is logged and that job is
# skipped (the server still boots).
MAINTENANCE_CRON=0 0 * * *

# When "false", the scheduled job only refreshes account-expiry notifications
# (no data removal at all). Retention can then still be run manually by an
# admin via POST /api/admin/retention/run. Default: true (same behaviour as
# before this feature existed: one archive-then-remove pass per day).
RETENTION_SCHEDULED_ENABLED=true

# ===== Optional: keep-alive ping (disabled by default) =====
# While the process is running, the server issues a GET to KEEP_ALIVE_URL
# every KEEP_ALIVE_INTERVAL_MINUTES (each request has KEEP_ALIVE_TIMEOUT_MS).
#
# LIMITATION — read before enabling: this is an INTERNAL ping. It can only
# generate traffic while THIS instance is awake. It CANNOT wake the same
# backend after Render has suspended it, and it does NOT guarantee the
# service never sleeps. On Render's free tier, sleep must be handled by an
# INDEPENDENT EXTERNAL uptime monitor / scheduler pinging the public URL
# (see server/RENDER_DEPLOYMENT.md for exact steps).
#
# Local dev: leave disabled (default), or point it at your local server:
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=
#   e.g. KEEP_ALIVE_URL=http://localhost:4000/api/health
# Render: set to the public health URL of THIS service (set the value in the
# Render dashboard AFTER the first deploy — never hardcode/commit it):
#   KEEP_ALIVE_URL=https://<your-service>.onrender.com/api/health
#
# Minutes between pings, clamped to 1..1440 (default 10). Keep it well under
# your monitor's interval so the two never fight; see the limitation above.
KEEP_ALIVE_INTERVAL_MINUTES=10
# Per-request timeout in milliseconds, clamped to 1000..60000 (default 10000).
KEEP_ALIVE_TIMEOUT_MS=10000
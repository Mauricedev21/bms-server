# ===== Server environment =====
# Node
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# MongoDB Atlas connection string (use atlas cluster in production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bms

# Optional in-memory (no Redis) fallback is automatic when REDIS_URL is empty.
REDIS_URL=

# Secrets - GENERATE your own values in .env
# The server REFUSES to boot in production without JWT_SECRET / MONGODB_URI.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS - comma separated origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Set to false to lock the public registration endpoint in production
ALLOW_REGISTRATION=true

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# Business settings
MANAGER_SHARE_PERCENT=60
BARBER_SHARE_PERCENT=40
CURRENCY=RWF
ACCOUNT_PERIOD_DAYS=30
NOTIFICATION_EXPIRY_DAYS=7
RETENTION_MONTHS=6

# Caching TTLs (seconds)
CACHE_TTL_USER=120
CACHE_TTL_SALON=120
CACHE_TTL_DASHBOARD=60
CACHE_TTL_LIST=60

# Retention service
RETENTION_CRON=EVERY_DAY_MIDNIGHT
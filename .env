NODE_ENV=development
PORT=4000
API_PREFIX=/api

MONGODB_URI=mongodb://127.0.0.1:27017/bms_dev

REDIS_URL=

JWT_SECRET=dev-secret-integration-check-session
JWT_EXPIRES_IN=30d

CLIENT_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

MANAGER_SHARE_PERCENT=60
BARBER_SHARE_PERCENT=40
CURRENCY=RWF
ACCOUNT_PERIOD_DAYS=30
NOTIFICATION_EXPIRY_DAYS=7
RETENTION_MONTHS=6

# Database usage widget quota in MB (default 512 = MongoDB Atlas free tier).
# Override to match your Atlas plan; set to 0 to use the database's own filesystem stats.
DB_STORAGE_LIMIT_MB=512

CACHE_TTL_USER=120
CACHE_TTL_SALON=120
CACHE_TTL_DASHBOARD=60
CACHE_TTL_LIST=60

RETENTION_CRON=EVERY_DAY_MIDNIGHT

ALLOW_REGISTRATION=true